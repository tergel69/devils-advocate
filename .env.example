# ---- LLM Provider ----
# By default, uses Ollama (free, local, no API key needed).
# Just install Ollama (https://ollama.com) and run: ollama pull qwen3:1.7b

# Optional: Override the Ollama model (default: qwen3:1.7b)
# OLLAMA_MODEL=qwen3:1.7b

# Optional: Ollama server URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# ---- Alternative Providers (optional) ----

# Google Gemini (free tier, requires: pip install research-agent[gemini])
# Get a free key at: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-google-api-key-here
# GEMINI_MODEL=gemini-2.0-flash

# OpenAI (paid, requires: pip install research-agent[openai])
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# Force a specific provider (auto-detected by default)
# LLM_PROVIDER=ollama  # or "gemini" or "openai"

# ---- Search ----

# Optional: Tavily API key for enhanced web search (falls back to DuckDuckGo)
# TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Optional: Max search results per query (default: 5)
# MAX_SEARCH_RESULTS=5

# Optional: Max pages to read per research cycle (default: 3)
# MAX_PAGES_TO_READ=3

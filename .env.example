# ---- LLM Provider (choose one) ----

# Option 1: Google Gemini (FREE - recommended)
# Get your free API key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Optional: Override the Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Option 2: OpenAI (paid, requires: pip install research-agent[openai])
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# Optional: Force a specific provider (auto-detected from API keys by default)
# LLM_PROVIDER=gemini  # or "openai"

# ---- Search ----

# Optional: Tavily API key for enhanced web search (falls back to DuckDuckGo)
# TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Optional: Max search results per query (default: 5)
# MAX_SEARCH_RESULTS=5

# Optional: Max pages to read per research cycle (default: 3)
# MAX_PAGES_TO_READ=3
